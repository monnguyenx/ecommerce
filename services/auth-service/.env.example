# Cổng dịch vụ
PORT=8001
NODE_ENV=development

# Cấu hình PostgreSQL (Database: ecommerce_auth_db)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecommerce_user
DB_PASSWORD=ecommerce_secret
DB_NAME=ecommerce_auth_db
DATABASE_URL=postgres://ecommerce_user:ecommerce_secret@localhost:5432/ecommerce_auth_db

# Giao tiếp liên dịch vụ (Inter-Service)
USER_SERVICE_URL=http://localhost:8002

# Bí mật mã hóa JWT
JWT_SECRET=omniorder_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=omniorder_super_refresh_jwt_key_2026
